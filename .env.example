# auto: 有完整主/备配置时使用远程 provider；没有 key 时自动使用 MockLLM。
LIGHTCONE_PROVIDER_MODE=auto
LIGHTCONE_RESEARCH_MODE=auto

# 主 provider。MODEL 使用账号实际可调用的模型 ID。
LIGHTCONE_PRIMARY_BASE_URL=
LIGHTCONE_PRIMARY_API_KEY=
LIGHTCONE_PRIMARY_MODEL=gpt-5.6-sol

# 备 provider。接口按 OpenAI-compatible chat/completions 配置。
LIGHTCONE_BACKUP_BASE_URL=
LIGHTCONE_BACKUP_API_KEY=
LIGHTCONE_BACKUP_MODEL=kimi-k3

# 可选：覆盖本地制品与 fixture 路径。
# LIGHTCONE_CATALOG_PATH=artifacts/catalog.sqlite
# LIGHTCONE_NUMERIC_DIR=artifacts/numeric
# LIGHTCONE_MOCK_FIXTURE=fixtures/investigations/mock_v1.json
# LIGHTCONE_RESEARCH_CORPUS=fixtures/research/mock_corpus_v1.json
# LIGHTCONE_RESEARCH_STAGING=artifacts/research_staging.sqlite
